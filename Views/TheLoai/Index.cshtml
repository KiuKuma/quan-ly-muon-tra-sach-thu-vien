@model IEnumerable<TheLoai>
@{
    ViewData["Title"] = "Thể loại";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">THỂ LOẠI</p>
        <h1>Thể loại</h1>
        <p class="text-secondary">@Model.Count() thể loại</p>
    </div>
    @if (User.IsInRole(LibraryRoles.QuanLy))
    {
        <a class="btn btn-primary" asp-action="Create">Thêm thể loại</a>
    }
</div>

<form asp-action="Index" method="get" class="search-row">
    <label for="search" class="visually-hidden">Tìm theo tên thể loại hoặc mô tả</label>
    <input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm thể loại" />
    <button type="submit" class="btn btn-outline-secondary">Tìm</button>
    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search))
    {
        <a class="btn btn-link" asp-action="Index">Xóa lọc</a>
    }
</form>

@if (!Model.Any())
{
    <div class="empty-state"><p>Chưa có thể loại nào.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Tên thể loại</th><th>Mô tả</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td class="fw-semibold">@category.TenTheLoai</td>
                    <td class="text-secondary">@(string.IsNullOrWhiteSpace(category.MoTa) ? "—" : category.MoTa)</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@category.Id">Xem</a>
                        @if (User.IsInRole(LibraryRoles.QuanLy))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@category.Id">Sửa</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@category.Id">Xóa</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}