@model TheLoai
@{
    ViewData["Title"] = "Chi tiết thể loại";
}

<section class="form-panel">
    <p class="eyebrow">THỂ LOẠI</p>
    <div class="page-heading compact-heading">
        <h1>@Model.TenTheLoai</h1>
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Sửa thể loại</a>
    </div>
    <dl class="detail-list">
        <dt>Mô tả</dt><dd>@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Chưa có mô tả" : Model.MoTa)</dd>
        <dt>Số đầu sách</dt><dd>@Model.Sach.Count</dd>
    </dl>
    @if (Model.Sach.Count > 0)
    {
        <h2 class="section-title">Sách thuộc thể loại</h2>
        <ul class="plain-list">
            @foreach (var book in Model.Sach.OrderBy(book => book.TenSach))
            {
                <li>@book.TenSach <span class="text-secondary">/ @book.TacGia</span></li>
            }
        </ul>
    }
    <a class="btn btn-link px-0" asp-action="Index">Quay lại danh sách</a>
</section>