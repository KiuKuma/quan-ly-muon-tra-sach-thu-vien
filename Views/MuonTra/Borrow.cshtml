@model BorrowPageViewModel
@{
    ViewData["Title"] = "Mượn sách";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">NGHIỆP VỤ THƯ VIỆN</p>
        <h1>Mượn sách</h1>
        <p class="text-secondary">Thời hạn tối đa @Model.LoanTermDays ngày, mỗi độc giả giữ tối đa @Model.MaxBooksPerReader bản sách cùng lúc.</p>
    </div>
</div>
<partial name="_LoanNavigation" />

<section class="form-panel form-panel-wide">
    <form asp-action="Borrow" method="post" class="form-grid form-grid-two" id="borrow-form">
        <div asp-validation-summary="ModelOnly" class="text-danger form-span-two" role="alert"></div>
        <div>
            <label asp-for="Loan.ReaderId" class="form-label">Mã độc giả</label>
            <select asp-for="Loan.ReaderId" class="form-select" id="reader-select">
                <option value="0">Chọn mã độc giả</option>
                @foreach (var reader in Model.Readers)
                {
                    <option value="@reader.Id" data-reader-name="@reader.Name">DG-@reader.Id · @reader.Name</option>
                }
            </select>
            <span asp-validation-for="Loan.ReaderId" class="text-danger"></span>
        </div>
        <div>
            <label class="form-label" for="reader-name">Tên độc giả</label>
            <input id="reader-name" class="form-control" readonly placeholder="Tự hiển thị theo mã độc giả" />
        </div>
        <div>
            <label asp-for="Loan.BorrowedAt" class="form-label"></label>
            <input asp-for="Loan.BorrowedAt" class="form-control" type="date" />
            <span asp-validation-for="Loan.BorrowedAt" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Loan.DueAt" class="form-label"></label>
            <input asp-for="Loan.DueAt" class="form-control" type="date" />
            <span asp-validation-for="Loan.DueAt" class="text-danger"></span>
        </div>

        <div class="form-span-two">
            <div class="section-heading loan-books-heading">
                <div><h2 class="h5 mb-0">Sách mượn</h2><p class="text-secondary mb-0">Mã sách, tác giả, nhà xuất bản và số lượng còn tự hiển thị.</p></div>
                <button class="btn btn-outline-primary" type="button" id="add-book-row">+ Chọn thêm sách</button>
            </div>
            <div id="borrow-book-rows">
                @for (var i = 0; i < Model.Loan.Items.Count; i++)
                {
                    var selectedBook = Model.Books.FirstOrDefault(book => book.Id == Model.Loan.Items[i].BookId);
                    <div class="borrow-book-row" data-book-row>
                        <div class="book-search-field">
                            <label class="form-label" data-book-label for="book-search-@i">Tên sách / mã sách</label>
                            <div class="book-picker" data-book-picker>
                                <input class="form-control book-search" id="book-search-@i" type="text"
                                       value="@(selectedBook?.Name ?? (Model.Loan.Items[i].BookId > 0 ? $"SH-{Model.Loan.Items[i].BookId}" : string.Empty))"
                                       placeholder="Nhập tên sách hoặc mã SH-..." autocomplete="off"
                                       role="combobox" aria-autocomplete="list" aria-expanded="false" />
                                <input asp-for="Loan.Items[i].BookId" type="hidden" class="book-select" />
                                <ul class="book-suggestions" role="listbox" hidden></ul>
                            </div>
                        </div>
                        <div class="book-quantity-field">
                            <label asp-for="Loan.Items[i].Quantity" class="form-label" data-quantity-label>Số lượng mượn</label>
                            <input asp-for="Loan.Items[i].Quantity" class="form-control book-quantity" min="1" max="100" />
                        </div>
                        <button class="btn btn-sm btn-outline-danger remove-book-row" type="button" aria-label="Xóa sách này">Xóa</button>
                        <div class="book-row-feedback">
                            <span asp-validation-for="Loan.Items[i].BookId" class="text-danger"></span>
                            <span asp-validation-for="Loan.Items[i].Quantity" class="text-danger"></span>
                            <div class="book-meta" data-book-meta>
                                @if (selectedBook is not null)
                                {
                                    <text>Mã sách: SH-@selectedBook.Id · Tác giả: @selectedBook.Author · Nhà xuất bản: @(selectedBook.Publisher ?? "—") · Còn: @selectedBook.AvailableCopies</text>
                                }
                                else
                                {
                                    <text>Nhập tên hoặc mã sách rồi chọn một kết quả.</text>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="form-actions form-span-two">
            <span class="text-secondary">Mã phiếu mượn sẽ được tự động cấp sau khi tạo phiếu.</span>
            <button type="submit" class="btn btn-primary">Tạo phiếu mượn</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </div>
    </form>
</section>

<template id="borrow-book-template">
    <div class="borrow-book-row" data-book-row>
        <div class="book-search-field">
            <label class="form-label" data-book-label>Tên sách / mã sách</label>
            <div class="book-picker" data-book-picker>
                <input class="form-control book-search" type="text" placeholder="Nhập tên sách hoặc mã SH-..."
                       autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" />
                <input type="hidden" class="book-select" value="0" />
                <ul class="book-suggestions" role="listbox" hidden></ul>
            </div>
        </div>
        <div class="book-quantity-field">
            <label class="form-label" data-quantity-label>Số lượng mượn</label>
            <input class="form-control book-quantity" type="number" min="1" max="100" value="1" data-book-quantity />
        </div>
        <button class="btn btn-sm btn-outline-danger remove-book-row" type="button" aria-label="Xóa sách này">Xóa</button>
        <div class="book-row-feedback">
            <div class="book-meta" data-book-meta>Nhập tên hoặc mã sách rồi chọn một kết quả.</div>
        </div>
    </div>
</template>

<script type="application/json" id="borrow-book-options">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Books))</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
