@model LibrarySettingsViewModel
@{
    ViewData["Title"] = "Quy định thư viện";
}

<section class="form-panel form-panel-wide">
    <p class="eyebrow">QUẢN TRỊ HỆ THỐNG</p>
    <h1>Quy định thư viện</h1>
    <p class="text-secondary">Các thay đổi áp dụng cho giao dịch mới; không tự sửa hạn trả hoặc tiền phạt đã chốt.</p>
    @if (ViewBag.UpdatedAt is DateTime updatedAt)
    {
        <p class="small text-secondary">Cập nhật gần nhất: @updatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") bởi @ViewBag.UpdatedBy</p>
    }
    <form asp-action="Index" method="post" class="form-grid form-grid-two">
        <div asp-validation-summary="ModelOnly" class="text-danger form-span-two" role="alert"></div>
        <div>
            <label asp-for="LoanTermDays" class="form-label"></label>
            <input asp-for="LoanTermDays" class="form-control" type="number" min="1" max="90" />
            <span asp-validation-for="LoanTermDays" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="MaxBooksPerReader" class="form-label"></label>
            <input asp-for="MaxBooksPerReader" class="form-control" type="number" min="1" max="50" />
            <span asp-validation-for="MaxBooksPerReader" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="DailyLateFine" class="form-label"></label>
            <input asp-for="DailyLateFine" class="form-control" type="number" min="0" step="1000" />
            <span asp-validation-for="DailyLateFine" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="DamagedBookFine" class="form-label"></label>
            <input asp-for="DamagedBookFine" class="form-control" type="number" min="0" step="1000" />
            <span asp-validation-for="DamagedBookFine" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="LostBookFine" class="form-label"></label>
            <input asp-for="LostBookFine" class="form-control" type="number" min="0" step="1000" />
            <span asp-validation-for="LostBookFine" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="ReaderMinimumAge" class="form-label"></label>
            <input asp-for="ReaderMinimumAge" class="form-control" type="number" min="0" max="120" />
            <span asp-validation-for="ReaderMinimumAge" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="ReaderMaximumAge" class="form-label"></label>
            <input asp-for="ReaderMaximumAge" class="form-control" type="number" min="1" max="120" />
            <span asp-validation-for="ReaderMaximumAge" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="ReaderCardValidityMonths" class="form-label"></label>
            <input asp-for="ReaderCardValidityMonths" class="form-control" type="number" min="1" max="120" />
            <span asp-validation-for="ReaderCardValidityMonths" class="text-danger"></span>
        </div>
        <div class="form-actions form-span-two">
            <button type="submit" class="btn btn-primary">Lưu quy định</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
