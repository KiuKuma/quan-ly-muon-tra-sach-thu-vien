@model PagedResult<DocGia>
@{
    ViewData["Title"] = "Độc giả";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">ĐỘC GIẢ</p>
        <h1>Độc giả</h1>
        <p class="text-secondary">@Model.TotalCount hồ sơ</p>
    </div>
    @if (User.IsInRole(LibraryRoles.QuanLy))
    {
        <a class="btn btn-primary" asp-action="Create">Thêm độc giả</a>
    }
</div>

<form asp-action="Index" method="get" class="search-row">
    <label for="search" class="visually-hidden">Tìm theo tên, email, điện thoại hoặc địa chỉ</label>
    <input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm tên, email, điện thoại hoặc địa chỉ" />
    <button type="submit" class="btn btn-outline-secondary">Tìm</button>
    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search))
    {
        <a class="btn btn-link" asp-action="Index">Xóa lọc</a>
    }
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty-state"><p>Không tìm thấy hồ sơ độc giả.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle responsive-data-table">
            <thead><tr><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Địa chỉ</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var reader in Model.Items)
            {
                <tr>
                    <td data-label="Họ tên" class="fw-semibold">@reader.HoTen</td>
                    <td data-label="Email">@reader.Email</td>
                    <td data-label="Điện thoại">@(reader.SoDienThoai ?? "—")</td>
                    <td data-label="Địa chỉ" class="cell-address">@(string.IsNullOrWhiteSpace(reader.DiaChi) ? "—" : reader.DiaChi)</td>
                    <td data-label="Thao tác" class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@reader.Id">Xem</a>
                        @if (User.IsInRole(LibraryRoles.QuanLy))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@reader.Id">Sửa</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@reader.Id">Xóa</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.TotalPages > 1)
{
    <partial name="_Pagination" model="Model.CreatePagination((string?)ViewBag.Search)" />
}