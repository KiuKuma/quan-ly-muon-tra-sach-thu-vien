@model ReaderHistoryViewModel
@{
    ViewData["Title"] = $"Lịch sử mượn - {Model.Reader.HoTen}";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">ĐỘC GIẢ · DG-@Model.Reader.Id</p>
        <h1>Lịch sử mượn trả</h1>
        <p class="text-secondary">@Model.Reader.HoTen</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Reader.Id">Hồ sơ độc giả</a>
</div>

<div class="alert @(Model.OutstandingFine > 0 ? "alert-danger" : "alert-success")" role="status">
    Tổng nợ phạt còn lại: <strong>@Model.OutstandingFine.ToString("N0") ₫</strong>
</div>

@if (Model.Loans.Count == 0)
{
    <div class="empty-state"><p>Độc giả chưa có lịch sử mượn sách.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle responsive-data-table">
            <thead><tr><th>Phiếu</th><th>Ngày mượn</th><th>Hạn trả</th><th>Sách</th><th>Trạng thái</th><th>Đã thu</th><th>Còn nợ</th><th></th></tr></thead>
            <tbody>
            @foreach (var loan in Model.Loans)
            {
                <tr>
                    <td>PM-@loan.Id</td>
                    <td>@loan.BorrowedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>@loan.DueAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>@string.Join(", ", loan.Books)</td>
                    <td>@loan.Status</td>
                    <td>@loan.FinePaid.ToString("N0") ₫</td>
                    <td>@loan.FineOutstanding.ToString("N0") ₫</td>
                    <td><a class="btn btn-sm btn-outline-secondary" asp-controller="MuonTra" asp-action="Details" asp-route-id="@loan.Id">Chi tiết</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
