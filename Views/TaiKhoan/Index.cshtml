@model IEnumerable<AccountSummaryViewModel>
@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">QUẢN LÝ / NHÂN SỰ</p>
        <h1>Quản lý nhân viên</h1>
        <p class="text-secondary">Danh sách các tài khoản nhân viên và quản lý được cấp quyền truy cập.</p>
    </div>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Tên tài khoản</th><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Vai trò</th><th></th></tr></thead>
        <tbody>
        @foreach (var account in Model)
        {
            <tr>
                <td class="fw-semibold">@account.Username</td>
                <td class="fw-semibold">@account.HoTen</td>
                <td>@account.Email</td>
                <td>@(account.SoDienThoai ?? "—")</td>
                <td>@account.Role</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@account.Id">Sửa hồ sơ</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>