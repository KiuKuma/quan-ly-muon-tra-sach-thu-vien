@model PagedResult<AccountSummaryViewModel>
@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">QUẢN LÝ / NHÂN SỰ</p>
        <h1>Quản lý nhân viên</h1>
        <p class="text-secondary">Quản lý hồ sơ và trạng thái tài khoản nhân viên · @Model.TotalCount tài khoản</p>
    </div>
</div>

@if (TempData["TemporaryPassword"] is string temporaryPassword)
{
    <div class="alert alert-warning" role="alert">
        Mật khẩu tạm mới: <code>@temporaryPassword</code>. Hãy lưu và gửi riêng cho nhân viên; mật khẩu sẽ không hiển thị lại.
    </div>
}

<div class="table-responsive">
    <table class="table align-middle responsive-data-table">
        <thead><tr><th>Tên tài khoản</th><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Địa chỉ</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var account in Model.Items)
        {
            <tr>
                <td data-label="Tên tài khoản" class="fw-semibold">@account.Username</td>
                <td data-label="Họ tên" class="fw-semibold">@account.HoTen</td>
                <td data-label="Email">@account.Email</td>
                <td data-label="Điện thoại">@(account.SoDienThoai ?? "—")</td>
                <td data-label="Địa chỉ" class="cell-address">@(string.IsNullOrWhiteSpace(account.DiaChi) ? "—" : account.DiaChi)</td>
                <td data-label="Vai trò">@account.Role</td>
                <td data-label="Trạng thái">@(account.IsActive ? "Đang hoạt động" : "Đã khóa")</td>
                <td data-label="Thao tác" class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@account.Id">Sửa hồ sơ</a>
                    <form asp-action="ResetPassword" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@account.Id" />
                        <button class="btn btn-sm btn-outline-warning" type="submit">Reset mật khẩu</button>
                    </form>
                    <form asp-action="SetActive" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@account.Id" />
                        <input type="hidden" name="isActive" value="@(!account.IsActive)" />
                        <button class="btn btn-sm @(account.IsActive ? "btn-outline-warning" : "btn-outline-success")" type="submit">
                            @(account.IsActive ? "Khóa" : "Mở khóa")
                        </button>
                    </form>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@account.Id">Xóa</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.TotalPages > 1)
{
    <partial name="_Pagination" model="Model.CreatePagination()" />
}