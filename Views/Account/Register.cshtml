@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký độc giả";
}

<section class="auth-panel auth-panel-wide">
    <p class="eyebrow">TÀI KHOẢN THƯ VIỆN</p>
    <h1>Tạo tài khoản độc giả</h1>
    <form asp-action="Register" method="post" class="form-grid form-grid-two">
        <div asp-validation-summary="ModelOnly" class="text-danger form-span-two" role="alert"></div>
        <div>
            <label asp-for="HoTen" class="form-label"></label>
            <input asp-for="HoTen" class="form-control" autocomplete="name" />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="SoDienThoai" class="form-label"></label>
            <input asp-for="SoDienThoai" class="form-control" autocomplete="tel" />
            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="DiaChi" class="form-label"></label>
            <input asp-for="DiaChi" class="form-control" autocomplete="street-address" />
            <span asp-validation-for="DiaChi" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="form-span-two">
            <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
            <a class="btn btn-link" asp-action="Login">Đã có tài khoản? Đăng nhập</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}