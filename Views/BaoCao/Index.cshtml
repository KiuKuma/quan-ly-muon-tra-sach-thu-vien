@model LibraryStatisticsViewModel
@{
    ViewData["Title"] = "Thống kê thư viện";
    var maxMonthlyLoans = Model.MonthlyStatistics.Select(item => item.BorrowedSlips).DefaultIfEmpty().Max();
    var maxPopularBooks = Model.MostBorrowedBooks.Select(item => item.CopiesBorrowed).DefaultIfEmpty().Max();
    var totalStatusCount = Model.StatusStatistics.Sum(item => item.Count);
}

<section class="dashboard-heading statistics-heading">
    <div>
        <p class="eyebrow">DÀNH CHO QUẢN LÝ</p>
        <h1>Thống kê thư viện</h1>
        <p class="dashboard-subtitle">Theo dõi tình hình mượn trả, sách được quan tâm và tiền phạt đã thu.</p>
    </div>
    <button id="print-statistics" type="button" class="btn btn-outline-secondary statistics-print">In báo cáo</button>
</section>

<nav class="statistics-quick-actions" aria-label="Thao tác nhanh">
    <a class="btn btn-sm btn-outline-secondary" asp-controller="MuonTra" asp-action="Borrow">Lập phiếu mượn</a>
    <a class="btn btn-sm btn-outline-secondary" asp-controller="MuonTra" asp-action="Return">Nhận trả sách</a>
    <a class="btn btn-sm btn-outline-secondary" asp-controller="Sach" asp-action="Index">Tra cứu kho sách <span aria-hidden="true">↗</span></a>
</nav>

<form asp-action="Index" method="get" class="statistics-filter">
    <div>
        <label for="startDate" class="form-label">Từ ngày</label>
        <input id="startDate" name="startDate" type="date" class="form-control"
               value="@Model.StartDate.ToString("yyyy-MM-dd")" min="2000-01-01"
               max="@Model.EndDate.ToString("yyyy-MM-dd")" required />
    </div>
    <div>
        <label for="endDate" class="form-label">Đến ngày</label>
        <input id="endDate" name="endDate" type="date" class="form-control"
               value="@Model.EndDate.ToString("yyyy-MM-dd")" min="@Model.StartDate.ToString("yyyy-MM-dd")"
               max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
    </div>
    <button type="submit" class="btn btn-primary">Lọc thống kê</button>
    <a asp-action="Index" class="btn btn-outline-secondary">6 tháng gần nhất</a>
</form>

<section class="statistics-summary" aria-label="Tổng kết khoảng thời gian đã chọn">
    <article class="statistics-summary-card">
        <span class="statistics-summary-label">Phiếu mượn</span>
        <strong>@Model.TotalBorrowedSlips</strong>
        <span class="statistics-summary-hint">Trong khoảng ngày đã chọn</span>
    </article>
    <article class="statistics-summary-card">
        <span class="statistics-summary-label">Phiếu trả</span>
        <strong>@Model.TotalReturnedSlips</strong>
        <span class="statistics-summary-hint">Theo ngày lập phiếu trả</span>
    </article>
    <article class="statistics-summary-card statistics-revenue-card">
        <span class="statistics-summary-label">Tiền phạt đã thu</span>
        <strong>@Model.TotalFineRevenue.ToString("N0") ₫</strong>
        <span class="statistics-summary-hint">Chỉ tính khoản đã thanh toán</span>
    </article>
</section>

<div class="statistics-dashboard-grid">
    <section class="statistics-panel">
        <div class="statistics-panel-heading">
            <div>
                <p class="eyebrow">XU HƯỚNG</p>
                <h2>Phiếu mượn theo thời gian</h2>
            </div>
            <span class="statistics-caption">@Model.MonthlyStatistics.Count tháng</span>
        </div>
        @if (Model.MonthlyStatistics.Count == 0)
        {
            <p class="statistics-empty mb-0">Không có dữ liệu trong khoảng thời gian này.</p>
        }
        else
        {
            <div class="statistics-month-chart" role="img" aria-label="Số phiếu mượn theo tháng">
                @foreach (var month in Model.MonthlyStatistics)
                {
                    var height = maxMonthlyLoans == 0 ? 0 : Math.Max(6, month.BorrowedSlips * 100 / maxMonthlyLoans);
                    <div class="statistics-month-column" title="@month.Label: @month.BorrowedSlips phiếu mượn">
                        <span class="statistics-month-value">@month.BorrowedSlips</span>
                        <div class="statistics-month-track">
                            <span class="statistics-month-bar" style="height: @height%"></span>
                        </div>
                        <span class="statistics-month-label">@month.Label</span>
                    </div>
                }
            </div>
            <p class="statistics-chart-note mb-0">Tổng tiền phạt đã thu trong kỳ: <strong>@Model.TotalFineRevenue.ToString("N0") ₫</strong></p>
        }
    </section>

    <section class="statistics-panel">
        <div class="statistics-panel-heading">
            <div>
                <p class="eyebrow">TRẠNG THÁI</p>
                <h2>Tình hình phiếu mượn</h2>
            </div>
            <span class="statistics-caption">@totalStatusCount phiếu</span>
        </div>
        <div class="statistics-status-list">
            @foreach (var status in Model.StatusStatistics)
            {
                var width = totalStatusCount == 0 ? 0 : status.Count * 100 / totalStatusCount;
                <div class="statistics-status-item">
                    <div class="statistics-status-heading">
                        <span>@status.Label</span>
                        <strong>@status.Count</strong>
                    </div>
                    <div class="statistics-status-track">
                        <span class="statistics-status-bar statistics-status-@status.Code" style="width: @width%"></span>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="statistics-panel">
        <div class="statistics-panel-heading">
            <div>
                <p class="eyebrow">ĐƯỢC QUAN TÂM</p>
                <h2>Sách được mượn nhiều</h2>
            </div>
            <a class="statistics-panel-link" asp-controller="Sach" asp-action="Index">Danh mục sách <span aria-hidden="true">→</span></a>
        </div>
        @if (Model.MostBorrowedBooks.Count == 0)
        {
            <p class="statistics-empty mb-0">Chưa có lượt mượn sách trong khoảng thời gian này.</p>
        }
        else
        {
            <ol class="statistics-popular-list">
                @foreach (var book in Model.MostBorrowedBooks)
                {
                    var width = maxPopularBooks == 0 ? 0 : book.CopiesBorrowed * 100 / maxPopularBooks;
                    <li>
                        <div class="statistics-book-heading">
                            <div>
                                <strong title="@book.Title">@book.Title</strong>
                                <span>@book.Author</span>
                            </div>
                            <b>@book.CopiesBorrowed bản</b>
                        </div>
                        <div class="statistics-popular-track">
                            <span style="width: @width%"></span>
                        </div>
                    </li>
                }
            </ol>
        }
    </section>

    <section class="statistics-panel statistics-recent-panel">
        <div class="statistics-panel-heading">
            <div>
                <p class="eyebrow">CẬP NHẬT MỚI</p>
                <h2>Phiếu mượn gần đây</h2>
            </div>
            <a class="statistics-panel-link" asp-controller="MuonTra" asp-action="Index">Tất cả phiếu <span aria-hidden="true">→</span></a>
        </div>
        @if (Model.RecentLoans.Count == 0)
        {
            <p class="statistics-empty mb-0">Không có phiếu mượn trong khoảng thời gian này.</p>
        }
        else
        {
            <div class="table-responsive statistics-recent-table-wrap">
                <table class="table align-middle statistics-recent-table responsive-data-table">
                    <thead>
                        <tr>
                            <th>Độc giả</th>
                            <th>Ngày mượn</th>
                            <th>Hạn trả</th>
                            <th>Trạng thái</th>
                            <th>Tiền phạt còn nợ</th>
                            <th>Phiếu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model.RecentLoans)
                        {
                            <tr>
                                <td data-label="Độc giả" class="statistics-reader-name">@loan.ReaderName</td>
                                <td data-label="Ngày mượn">@loan.BorrowedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td data-label="Hạn trả">@loan.DueAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td data-label="Trạng thái"><span class="loan-status loan-status-@loan.StatusCode">@loan.Status</span></td>
                                <td data-label="Tiền phạt còn nợ">@loan.FineOutstanding.ToString("N0") ₫</td>
                                <td data-label="Phiếu"><a asp-controller="MuonTra" asp-action="Details" asp-route-id="@loan.Id" aria-label="Xem phiếu PM-@loan.Id">PM-@loan.Id</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        document.getElementById("print-statistics")?.addEventListener("click", () => window.print());

        const startDate = document.getElementById("startDate");
        const endDate = document.getElementById("endDate");
        startDate?.addEventListener("change", () => {
            endDate.min = startDate.value;
            if (endDate.value < startDate.value) {
                endDate.value = startDate.value;
            }
        });
        endDate?.addEventListener("change", () => {
            startDate.max = endDate.value;
        });
    </script>
}
